{
  "publicOrigin": "https://nova.example.com",
  "port": 8080,
  "sessionHours": 8,
  "maxBodyMB": 12,
  "requestTimeoutSeconds": 900,
  "requestsPerMinute": 60,
  "concurrentRequestsPerUser": 4,
  "oidc": {
    "issuer": "https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0",
    "clientId": "YOUR-APPLICATION-CLIENT-ID",
    "clientSecretEnv": "NOVA_OIDC_CLIENT_SECRET",
    "scopes": "openid profile email",
    "groupsClaim": "groups",
    "allowedGroups": []
  },
  "ui": {
    "theme": "system",
    "branding": { "appName": "IDK Nova", "workspaceName": "Nova Workspace", "accent": "#8b5cf6", "logoDataUrl": "" }
  },
  "providers": [
    {
      "id": "company-ai",
      "name": "Company AI",
      "baseUrl": "https://ai.goldiran.ir/v1",
      "apiKeyEnv": "NOVA_COMPANY_AI_KEY",
      "models": ["goldiran-auto"]
    }
  ],
  "defaultProviderId": "company-ai",
  "defaultModel": "goldiran-auto"
}
