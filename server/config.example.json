{
  "publicOrigin": "https://nova.company.internal",
  "port": 8080,
  "sessionHours": 8,
  "maxBodyMB": 12,
  "requestTimeoutSeconds": 900,
  "requestsPerMinute": 60,
  "concurrentRequestsPerUser": 4,
  "oidc": {
    "issuer": "https://sso.company.internal/realms/company",
    "clientId": "nova-web",
    "clientSecretEnv": "NOVA_OIDC_CLIENT_SECRET",
    "scopes": "openid profile email",
    "uiLocales": "fa en",
    "groupsClaim": "groups",
    "allowedGroups": ["nova-users"]
  },
  "ui": {
    "theme": "system",
    "branding": { "appName": "IDK Nova", "workspaceName": "Nova Workspace", "accent": "#8b5cf6", "logoDataUrl": "" }
  },
  "providers": [
    {
      "id": "company-ai",
      "name": "Company AI",
      "baseUrl": "https://ai.company.internal/v1",
      "apiKeyEnv": "NOVA_COMPANY_AI_KEY",
      "models": ["company-model"]
    }
  ],
  "defaultProviderId": "company-ai",
  "defaultModel": "company-model"
}
