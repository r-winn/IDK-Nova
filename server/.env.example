# Never commit or distribute the real .env. Restrict it to the server administrator.
NOVA_DOMAIN=nova.company.internal
# OIDC secret issued by internal Keycloak or on-prem AD FS.
NOVA_OIDC_CLIENT_SECRET=REPLACE_WITH_IDP_CLIENT_SECRET
# AI provider connectivity is separate from AD. It may be internal or external.
NOVA_COMPANY_AI_KEY=REPLACE_WITH_COMPANY_PROVIDER_KEY
