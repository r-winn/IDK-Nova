{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDK Nova",
  "version": "0.5.2",
  "identifier": "com.idk.nova",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1430", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "IDK Nova", "width": 1240, "height": 820, "minWidth": 760, "minHeight": 560, "center": true, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "publisher": "IDK Nova Open Source",
    "copyright": "Copyright © 2026 IDK Nova contributors",
    "category": "Productivity",
    "shortDescription": "Private, configurable AI workspace",
    "longDescription": "IDK Nova connects to local and cloud AI models with support for conversations, images, files and voice input.",
    "windows": {
      "allowDowngrades": false,
      "wix": { "language": "en-US" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "IDK Nova",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMkMwMzkwRUQ4NUMyMTUKUldRVndvWHRrQU1zSFhLTmJiWHZzbGdGckZ4SGg5SFF0UWI5bEczcDVMNFdkUkR2V0xFYmd3aE0K",
      "endpoints": ["https://github.com/r-winn/IDK-Nova/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
